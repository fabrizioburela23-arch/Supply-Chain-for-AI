# riesgo de hornear un .env con keys dentro.
.git
.gitignore
.github
.claude
.env
.env.*
!.env.example
tests
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.venv
venv
node_modules
frontend/dist
*.log
.DS_Store
Thumbs.db
