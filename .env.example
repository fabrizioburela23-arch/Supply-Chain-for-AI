# Khipu Finance — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# Keys live ONLY on the server (the browser key panel and standalone mode were removed in 2026-07).
# FULL list of every variable the code reads (with defaults): CLAUDE.md → "Variables de entorno".
# Everything below is optional: without a key, that feature degrades with an honest message.

# ── Core ────────────────────────────────────────────────────────
# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret

# ── Market Data ─────────────────────────────────────────────────
# Finnhub (free tier OK for development): https://finnhub.io/register
FINNHUB_KEY=your_finnhub_api_key_here

# Financial Modeling Prep (fundamentals, price targets): https://financialmodelingprep.com/developer
FMP_KEY=your_fmp_key_here

# Marketstack (EOD prices): https://marketstack.com
MARKETSTACK_KEY=your_marketstack_key_here

# Alpha Vantage (free tier, needed for VaR/CVaR): https://www.alphavantage.co/support/#api-key
AV_KEY=your_alpha_vantage_key_here

# ── AI / Claude ─────────────────────────────────────────────────
# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_KEY=sk-ant-...

# ── Bixby Voice (ElevenLabs) ────────────────────────────────────
# ElevenLabs API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_KEY=your_elevenlabs_key_here
# ElevenLabs Conversational AI agent ID (create at elevenlabs.io/app/conversational-ai)
ELEVENLABS_AGENT_ID=your_agent_id_here


# ── Security / Hardening (Fase 2) ───────────────────────────────
# Content-Security-Policy. Activada por defecto en modo servidor. Solo afecta
# cuando Flask sirve la app (no aplica a standalone file://).
CSP_ENABLED=true
# Pon en true para probar la CSP sin bloquear nada (el navegador solo reporta
# violaciones). Útil al desplegar cambios de frontend con CDNs nuevos.
CSP_REPORT_ONLY=false

# ── Flask Config ────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000

# ── Ontology / decisions ledger (optional; without it the app runs from the snapshot) ──
# DATABASE_URL=postgresql://postgres:devpass@localhost:5432/khipus_test

# ── Trading (without TRADE_PIN every /api/trade/* route answers 403) ──
# TRADE_PIN=choose-a-strong-pin
# ALPACA_KEY=...
# ALPACA_SECRET=...
# ALPACA_BASE=https://paper-api.alpaca.markets

# ── More AI providers (cascade) ──
# GEMINI_KEY=...
# NVIDIA_KEY=...
